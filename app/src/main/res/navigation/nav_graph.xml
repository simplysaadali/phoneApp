<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/contactListFragment">

    <!-- Contact List Screen -->
    <fragment
        android:id="@+id/contactListFragment"
        android:name="com.example.phoneapp.ui.ContactListFragment"
        android:label="Contacts"
        tools:layout="@layout/fragment_contact_list">

        <!-- Navigate to Contact Detail -->
        <action
            android:id="@+id/action_contactListFragment_to_contactDetailFragment"
            app:destination="@id/contactDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <!-- Navigate to Add/Edit Contact (new contact: contactId = 0) -->
        <action
            android:id="@+id/action_contactListFragment_to_addEditContactFragment"
            app:destination="@id/addEditContactFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="contactId"
                app:argType="long" />
        </action>
    </fragment>

    <!-- Contact Detail Screen -->
    <fragment
        android:id="@+id/contactDetailFragment"
        android:name="com.example.phoneapp.ui.ContactDetailFragment"
        android:label="Contact Detail"
        tools:layout="@layout/fragment_contact_detail">

        <argument
            android:name="contactId"
            app:argType="long" />

        <!-- Navigate to Edit Contact -->
        <action
            android:id="@+id/action_contactDetailFragment_to_addEditContactFragment"
            app:destination="@id/addEditContactFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="contactId"
                app:argType="long" />
        </action>
    </fragment>

    <!-- Add / Edit Contact Screen -->
    <fragment
        android:id="@+id/addEditContactFragment"
        android:name="com.example.phoneapp.ui.AddEditContactFragment"
        android:label="Add Contact"
        tools:layout="@layout/fragment_add_edit_contact">

        <argument
            android:name="contactId"
            app:argType="long"
            android:defaultValue="0L" />
    </fragment>

</navigation>
