<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <!-- Top Display Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/tvMatchingName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvDialedNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Dial a number"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:maxLines="1" />

        </HorizontalScrollView>

    </LinearLayout>

    <!-- Keypad Grid (3 columns x 4 rows) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1: 1, 2, 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <!-- 1 -->
            <LinearLayout
                android:id="@+id/btnKey1"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/dialpad_button_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" "
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

            </LinearLayout>

            <Space android:layout_width="32dp" android:layout_height="1dp" />

            <!-- 2 -->
            <LinearLayout
                android:id="@+id/btnKey2"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/dialpad_button_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ABC"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Space android:layout_width="32dp" android:layout_height="1dp" />

            <!-- 3 -->
            <LinearLayout
                android:id="@+id/btnKey3"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/dialpad_button_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEF"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Row 2: 4, 5, 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <!-- 4 -->
            <LinearLayout
                android:id="@+id/btnKey4"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/dialpad_button_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GHI"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Space android:layout_width="32dp" android:layout_height="1dp" />

            <!-- 5 -->
            <LinearLayout
                android:id="@+id/btnKey5"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/dialpad_button_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JKL"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Space android:layout_width="32dp" android:layout_height="1dp" />

            <!-- 6 -->
            <LinearLayout
                android:id="@+id/btnKey6"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/dialpad_button_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MNO"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Row 3: 7, 8, 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <!-- 7 -->
            <LinearLayout
                android:id="@+id/btnKey7"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/dialpad_button_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PQRS"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Space android:layout_width="32dp" android:layout_height="1dp" />

            <!-- 8 -->
            <LinearLayout
                android:id="@+id/btnKey8"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/dialpad_button_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TUV"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Space android:layout_width="32dp" android:layout_height="1dp" />

            <!-- 9 -->
            <LinearLayout
                android:id="@+id/btnKey9"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/dialpad_button_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WXYZ"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Row 4: *, 0, # -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <!-- * -->
            <LinearLayout
                android:id="@+id/btnKeyStar"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/dialpad_button_bg"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="*"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Space android:layout_width="32dp" android:layout_height="1dp" />

            <!-- 0 -->
            <LinearLayout
                android:id="@+id/btnKey0"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/dialpad_button_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Space android:layout_width="32dp" android:layout_height="1dp" />

            <!-- # -->
            <LinearLayout
                android:id="@+id/btnKeyPound"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/dialpad_button_bg"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Actions: Spacer/Add, Call Button, Backspace -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <!-- Left placeholder to balance layout -->
        <View
            android:layout_width="56dp"
            android:layout_height="56dp" />

        <Space android:layout_width="38dp" android:layout_height="1dp" />

        <!-- Green Call Button -->
        <ImageButton
            android:id="@+id/btnCall"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/call_button_bg"
            android:src="@drawable/ic_call_green"
            android:scaleType="centerInside"
            android:elevation="4dp"
            android:contentDescription="@string/call" />

        <Space android:layout_width="38dp" android:layout_height="1dp" />

        <!-- Backspace Button -->
        <ImageButton
            android:id="@+id/btnBackspace"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_backspace"
            android:scaleType="centerInside"
            android:contentDescription="Backspace" />

    </LinearLayout>

</LinearLayout>
